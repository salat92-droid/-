                <div class="chat-header">
                    <button class="chat-back" onclick="showPage('home')">←</button>
                    <img src="" id="chat-header-avatar" class="chat-avatar">
                    <div class="chat-info"><h3 id="chat-header-name">Имя</h3><p>онлайн</p></div>
                </div>
                <div class="chat-messages" id="chat-messages"></div>
                <div class="chat-input-area">
                    <input type="text" id="chat-input" placeholder="Написать сообщение..." onkeydown="if(event.key === 'Enter') sendMessage()">
                    <button class="chat-send" onclick="sendMessage()">➤</button>
                </div>
            </div>
        </div>
    </main>

    <!-- ВОДЯНОЙ ЗНАК -->
    <div class="watermark">
        Школьный проект: Шильцов Родион, Вавилов Александр, Поломошнов Дмитрий — 7В
    </div>

    <script>
        // --- ЛОГИКА ТЕМЫ ---
        const themeBtn = document.getElementById('theme-toggle');
        
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-theme');
            themeBtn.innerText = '☀️';
        }

        function toggleTheme() {
            document.body.classList.toggle('dark-theme');
            if (document.body.classList.contains('dark-theme')) {
                localStorage.setItem('theme', 'dark');
                themeBtn.innerText = '☀️';
            } else {
                localStorage.setItem('theme', 'light');
                themeBtn.innerText = '🌙';
            }
        }

        // --- РАБОЧИЕ ЛАЙКИ ---
        let likedPets = JSON.parse(localStorage.getItem('murlykLikes')) || [];

        function initLikes() {
            document.querySelectorAll('.card-heart').forEach(heart => {
                const card = heart.closest('.pet-card');
                const petId = card.getAttribute('data-id');
                
                if (likedPets.includes(petId)) {
                    heart.classList.add('liked');
                }
            });
        }

        function toggleLike(event, petId, element) {
            event.stopPropagation(); 
            
            if (likedPets.includes(petId)) {
                likedPets = likedPets.filter(id => id !== petId);
                element.classList.remove('liked');
            } else {
                likedPets.push(petId);
                element.classList.add('liked');
            }
            
            localStorage.setItem('murlykLikes', JSON.stringify(likedPets));
        }

        // --- КАСТОМНЫЕ ФИЛЬТРЫ ---
        let currentFilters = { type: 'all', gender: 'all', age: 'all' };

        function toggleDropdown(dropdownId, btn) {
            document.querySelectorAll('.dropdown-menu').forEach(menu => {
                if (menu.id !== dropdownId) menu.classList.remove('show');
            });
            document.querySelectorAll('.custom-select-btn').forEach(b => {
                if (b !== btn) b.classList.remove('active');
            });

            const dropdown = document.getElementById(dropdownId);
            dropdown.classList.toggle('show');
            btn.classList.toggle('active');
        }

        document.addEventListener('click', function(event) {
            if (!event.target.closest('.filter-group')) {
                document.querySelectorAll('.dropdown-menu').forEach(menu => menu.classList.remove('show'));
                document.querySelectorAll('.custom-select-btn').forEach(btn => btn.classList.remove('active'));
            }
        });

        function selectFilter(filterName, value, labelText, element) {
            document.getElementById('label-' + filterName).innerText = labelText;
            
            const parentMenu = element.parentElement;
            parentMenu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('selected'));
            element.classList.add('selected');

            currentFilters[filterName] = value;
            parentMenu.classList.remove('show');
            parentMenu.previousElementSibling.classList.remove('active');

            applyFilters();
        }

        function filterPets(type) {
            const label = type === 'cats' ? 'Кошки' : 'Собаки';
            const dropdownItems = document.querySelectorAll('#dropdown-type .dropdown-item');
            let selectedItem = null;
            
            dropdownItems.forEach(item => {
                if (item.innerText === label) selectedItem = item;
            });
            
            selectFilter('type', type, label, selectedItem);
            document.getElementById('pets').scrollIntoView({ behavior: 'smooth' });
        }

        function applyFilters() {
            const cards = document.querySelectorAll('.pet-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardType = card.getAttribute('data-type');
                const cardGender = card.getAttribute('data-gender');
                const cardAge = card.getAttribute('data-age');

                const matchType = (currentFilters.type === 'all' || cardType === currentFilters.type);
                const matchGender = (currentFilters.gender === 'all' || cardGender === currentFilters.gender);
                const matchAge = (currentFilters.age === 'all' || cardAge === currentFilters.age);

                if (matchType && matchGender && matchAge) {
                    card.classList.remove('hide');
                    visibleCount++;
                } else {
                    card.classList.add('hide');
                }
            });

            document.getElementById('no-results').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        function resetFilters() {
            currentFilters = { type: 'all', gender: 'all', age: 'all' };
            
            document.getElementById('label-type').innerText = 'Все';
            document.getElementById('label-gender').innerText = 'Любой';
            document.getElementById('label-age').innerText = 'Любой';

            ['type', 'gender', 'age'].forEach(filter => {
                const menu = document.getElementById('dropdown-' + filter);
                menu.querySelectorAll('.dropdown-item').forEach((item, index) => {
                    item.classList.remove('selected');
                    if (index === 0) item.classList.add('selected');
                });
                menu.classList.remove('show');
                menu.previousElementSibling.classList.remove('active');
            });

            applyFilters();
        }

        // --- АНИМАЦИИ И НАВИГАЦИЯ ---
        const reveals = document.querySelectorAll('.reveal');
        function checkReveal() {
            const windowHeight = window.innerHeight;
            reveals.forEach((reveal) => {
                if (reveal.getBoundingClientRect().top < windowHeight - 100) reveal.classList.add('active');
            });
        }
        window.addEventListener('scroll', checkReveal);
        window.addEventListener('load', checkReveal);

        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById('page-' + pageId).classList.add('active');
            window.scrollTo(0, 0);
            
            const header = document.getElementById('main-header');
            if (pageId === 'event') {
                header.classList.add('event-header');
                createParticles();
            } else {
                header.classList.remove('event-header');
            }
        }

        // --- ГЕНЕРАЦИЯ ЧАСТИЦ ---
        function createParticles() {
            const container = document.getElementById('particles');
            container.innerHTML = ''; 
            for (let i = 0; i < 40; i++) {
                const particle = document.createElement('div');
                particle.classList.add('particle');
                
                const size = Math.random() * 8 + 3;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.animationDelay = `${Math.random() * 15}s`;
                particle.style.animationDuration = `${Math.random() * 10 + 10}s`;
                
                container.appendChild(particle);
            }
        }

        // --- АВТОРИЗАЦИЯ И ПРОФИЛЬ ---
        const authBtn = document.getElementById('auth-btn');
        function checkAuth() {
            const user = localStorage.getItem('murlykUser');
            if (user) showPage('profile'); else showPage('register');
        }

        function handleRegister(event) {
            event.preventDefault();
            const user = {
                name: document.getElementById('reg-name').value,
                surname: document.getElementById('reg-surname').value,
                city: document.getElementById('reg-city').value,
                phone: document.getElementById('reg-phone').value,
                email: document.getElementById('reg-email').value,
                avatar: null,
                cover: null
            };
            localStorage.setItem('murlykUser', JSON.stringify(user));
            updateUI();
            showPage('home');
            alert('Вы успешно зарегистрированы!');
        }

        function updateUI() {
            const userString = localStorage.getItem('murlykUser');
            if (userString) {
                const user = JSON.parse(userString);
                authBtn.innerText = `Привет, ${user.name}!`;
                document.getElementById('prof-display-name').innerHTML = `${user.name} ${user.surname} <button class="btn-edit" onclick="toggleEdit()">✏️ Ред.</button>`;
                document.getElementById('prof-display-city').innerText = `г. ${user.city}`;
                document.getElementById('prof-phone').innerText = user.phone;
                document.getElementById('prof-email').innerText = user.email;
                
                const avatarDiv = document.getElementById('prof-avatar');
                if (user.avatar) {
                    avatarDiv.style.backgroundImage = `url(${user.avatar})`;
                    avatarDiv.innerText = '';
                } else {
                    avatarDiv.style.backgroundImage = 'none';
                    avatarDiv.innerText = user.name.charAt(0).toUpperCase();
                }

                const coverDiv = document.getElementById('prof-cover');
                if (user.cover) {
                    coverDiv.style.backgroundImage = `url(${user.cover})`;
                } else {
                    coverDiv.style.backgroundImage = `linear-gradient(135deg, #4a90e2, #62b6cb)`;
                }

            } else {
                authBtn.innerText = 'Регистрация';
            }
        }

        function changeAvatar(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const user = JSON.parse(localStorage.getItem('murlykUser'));
                    user.avatar = e.target.result;
                    localStorage.setItem('murlykUser', JSON.stringify(user));
                    updateUI();
                };
                reader.readAsDataURL(file);
            }
        }

        function changeCover(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const user = JSON.parse(localStorage.getItem('murlykUser'));
                    user.cover = e.target.result;
                    localStorage.setItem('murlykUser', JSON.stringify(user));
                    updateUI();
                };
                reader.readAsDataURL(file);
            }
        }

        function toggleEdit() {
            const h2 = document.getElementById('prof-display-name');
            const input = document.getElementById('edit-name-input');
            const user = JSON.parse(localStorage.getItem('murlykUser'));
            h2.style.display = 'none';
            input.style.display = 'block';
            input.value = `${user.name} ${user.surname}`;
            input.focus();
        }

        function saveName() {
            const input = document.getElementById('edit-name-input');
            const newName = input.value.trim();
            if (newName) {
                const user = JSON.parse(localStorage.getItem('murlykUser'));
                const parts = newName.split(' ');
                user.name = parts[0];
                user.surname = parts.slice(1).join(' ') || '';
                localStorage.setItem('murlykUser', JSON.stringify(user));
                updateUI();
            }
            input.style.display = 'none';
            document.getElementById('prof-display-name').style.display = 'block';
        }

        function logout() {
            localStorage.removeItem('murlykUser');
            updateUI();
            showPage('home');
        }

        // --- ЧАТ ---
        let currentChatName = '';
        function openChat(name, imgUrl) {
            currentChatName = name;
            document.getElementById('chat-header-name').innerText = name;
            document.getElementById('chat-header-avatar').src = imgUrl;
            const chatMessages = document.getElementById('chat-messages');
            chatMessages.innerHTML = ''; 
            const history = JSON.parse(localStorage.getItem('chat_' + name)) || [];
            if (history.length === 0) {
                addMessage(`Привет! Меня зовут ${name}. Я ищу новый дом. Задавайте вопросы!`, 'bot', name);
            } else {
                history.forEach(msg => addMessage(msg.text, msg.sender, name, msg.time, false));
            }
            showPage('chat');
        }

        function sendMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (text === '') return;
            addMessage(text, 'user', currentChatName);
            input.value = '';
            setTimeout(() => {
                const botReplies = [
                    "Он очень ласковый и любит играть!",
                    "Да, он привит и ходит в лоток.",
                    "Кушает обычный корм. Могу отдать вместе с игрушками.",
                    "Он не агрессивный, отлично ладит с детьми.",
                    "Сможете приехать посмотреть на него в выходные?"
                ];
                const randomReply = botReplies[Math.floor(Math.random() * botReplies.length)];
                addMessage(randomReply, 'bot', currentChatName);
            }, 1000);
        }

        function addMessage(text, sender, petName, customTime = null, save = true) {
            const chatMessages = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            msgDiv.className = `message msg-${sender}`;
            const now = new Date();
            const timeStr = customTime || now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            msgDiv.innerHTML = `${text} <span class="msg-time">${timeStr}</span>`;
            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            if (save) {
                const history = JSON.parse(localStorage.getItem('chat_' + petName)) || [];
                history.push({ text, sender, time: timeStr });
                localStorage.setItem('chat_' + petName, JSON.stringify(history));
            }
        }

        // Инициализация
        updateUI();
        initLikes();
    </script>
</body>
</html>
